# AI_PROVIDER controls which summary backend is used.
# Use "local" for no external API calls, or set "openai" / "gemini" with the matching key below.
AI_PROVIDER=local

# OpenAI option. Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini option. Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
